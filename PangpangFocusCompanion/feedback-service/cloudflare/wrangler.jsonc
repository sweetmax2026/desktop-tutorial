{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pang-feedback",
  "account_id": "2c5b43bf793be6697a8635ab94101362",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "observability": { "enabled": false },
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "pang-feedback", "database_id": "3f9b95a0-59eb-4bdb-966b-96e2ec813555", "migrations_dir": "migrations" }]
  // ADMIN_PASSWORD must be set via `wrangler secret put`, never plain vars.
}
